{
  "name": "agentpane",
  "version": "0.1.1",
  "description": "Local server for AgentPane — web interface for AI coding agents",
  "type": "module",
  "bin": {
    "agentpane": "bin/agentpane.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "build:compile": "bun build --compile src/index.ts --outfile dist/agentpane",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "acp",
    "agent",
    "claude",
    "coding-agent",
    "agentpane"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgub/agentpane.git",
    "directory": "apps/server"
  },
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@effect/sql": "^0.49.0",
    "@effect/sql-sqlite-bun": "^0.50.0",
    "@zed-industries/claude-code-acp": "^0.16.0",
    "@zed-industries/codex-acp": "^0.9.2",
    "effect": "^3.19.16",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/bun": "^1"
  }
}
